# Nothing here is required. The site builds and runs with no keys at all.
# In GitHub Actions these are repository *variables* (Settings > Secrets and variables > Actions > Variables).

# Canonical origin for links, sitemaps and share cards (default: the GitHub Pages URL).
SITE_URL=https://theguysaccount.github.io/independents-win-tracker

# Optional cookieless analytics: the count endpoint of a GoatCounter site, e.g. https://<code>.goatcounter.com/count
GOATCOUNTER_URL=

# Optional money slot: a support link shown in the footer (e.g. a GitHub Sponsors page). Upkeep only;
# never a donation link for a candidate.
SUPPORT_URL=
SUPPORT_LABEL=Support this tracker
